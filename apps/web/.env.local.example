# Copy this file to .env.local and fill in values for local development.
# .env.local is gitignored and never committed.

# Supabase — use lycert-staging values for local dev
NEXT_PUBLIC_LYCERT_SUPABASE_URL=https://<staging-project-ref>.supabase.co
NEXT_PUBLIC_LYCERT_SUPABASE_ANON_KEY=

# FastAPI backend (Railway staging for local dev, or http://localhost:8000 if running locally)
NEXT_PUBLIC_LYCERT_API_URL=https://api-staging.example.com
