# Lycert Environment Variables
# Copy this file to .env.staging or .env.production and fill in values.
# NEVER commit .env.staging or .env.production to the repo.

# ── Supabase ──────────────────────────────────────────────────────────────────
LYCERT_SUPABASE_URL=
LYCERT_SUPABASE_ANON_KEY=
LYCERT_SUPABASE_SERVICE_ROLE_KEY=

# ── FastAPI Backend ───────────────────────────────────────────────────────────
LYCERT_API_SECRET_KEY=
LYCERT_ALLOWED_ORIGINS=
# e.g. LYCERT_ALLOWED_ORIGINS=https://lycert.com,https://staging.example.com

# ── Anthropic ─────────────────────────────────────────────────────────────────
LYCERT_ANTHROPIC_API_KEY=

# ── Enrichment ────────────────────────────────────────────────────────────────
LYCERT_CLAY_API_KEY=
LYCERT_PDL_API_KEY=
LYCERT_APOLLO_API_KEY=
# V2 waterfall providers (LYCERT_WATERFALL_ENRICHMENT_V2.md). Configure in BOTH staging + prod.
LYCERT_ZEROBOUNCE_API_KEY=
LYCERT_HUNTER_API_KEY=
LYCERT_REVERSECONTACT_API_KEY=
LYCERT_DATAGMA_API_KEY=
LYCERT_FULLENRICH_API_KEY=
# Public URL FullEnrich POSTs async results to (set per environment).
LYCERT_FULLENRICH_WEBHOOK_URL=
# Webhook signature header name — confirm FullEnrich's real scheme before production go-live.
# Defaults to X-FullEnrich-Signature (HMAC-SHA1 of the raw body, keyed by the API key).
LYCERT_FULLENRICH_SIGNATURE_HEADER=

# ── Email ─────────────────────────────────────────────────────────────────────
LYCERT_RESEND_API_KEY=

# ── Stripe ────────────────────────────────────────────────────────────────────
LYCERT_STRIPE_SECRET_KEY=
LYCERT_STRIPE_WEBHOOK_SECRET=
LYCERT_STRIPE_PUBLISHABLE_KEY=

# ── WorkOS (Phase 3 — SSO) ────────────────────────────────────────────────────
LYCERT_WORKOS_API_KEY=
LYCERT_WORKOS_CLIENT_ID=

# ── Redis (Upstash) ───────────────────────────────────────────────────────────
LYCERT_REDIS_URL=
LYCERT_REDIS_TOKEN=

# ── Environment identifier ────────────────────────────────────────────────────
LYCERT_ENV=staging
# Values: staging | production

# ── Railway (set automatically by Railway, do not set manually) ───────────────
# RAILWAY_ENVIRONMENT=
# RAILWAY_SERVICE_NAME=
